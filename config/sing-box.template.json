{
    "log": {
        "level": "info",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "type": "udp",
                "tag": "google",
                "server": "8.8.8.8",
                "detour": "direct"
            },
            {
                "type": "udp",
                "tag": "cf",
                "server": "1.1.1.1",
                "detour": "direct"
            }
        ],
        "final": "google",
        "strategy": "prefer_ipv4"
    },
    "inbounds": [
        {
            "type": "vless",
            "tag": "vless-in",
            "listen": "::",
            "listen_port": 443,
            "udp_fragment": true,
            "users": [],
            "tls": {
                "enabled": true,
                "server_name": "example.com",
                "reality": {
                    "enabled": true,
                    "handshake": {
                        "server": "example.com",
                        "server_port": 443
                    },
                    "private_key": "",
                    "short_id": []
                }
            }
        },
        {
            "type": "hysteria2",
            "tag": "hy2-in",
            "listen": "::",
            "listen_port": 443,
            "ignore_client_bandwidth": true,
            "users": [],
            "obfs": {
                "type": "salamander",
                "password": ""
            },
            "masquerade": "https://www.bing.com",
            "tls": {
                "enabled": true,
                "alpn": [
                    "h3"
                ],
                "certificate_path": "/etc/sing-box/cert/cert.pem",
                "key_path": "/etc/sing-box/cert/key.pem"
            }
        }
    ],
    "outbounds": [
        {
            "type": "direct",
            "tag": "direct"
        },
        {
            "type": "block",
            "tag": "block"
        }
    ],
    "route": {
        "rules": [
            {
                "inbound": [
                    "vless-in",
                    "hy2-in"
                ],
                "action": "sniff"
            },
            {
                "protocol": "dns",
                "action": "hijack-dns"
            }
        ],
        "final": "direct"
    }
}