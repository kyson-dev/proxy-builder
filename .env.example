# Sing-box REALITY 配置底层参数 (必需)
# 可以使用 `make reality-key` 和 `make short-id` 生成
# 支持多个 Short ID，请使用逗号分隔 (例如: a1b2c3d4,5a6b7c8d)
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=
# 伪装目标网站，必须支持 TLS 1.3 且不禁止外部握手。
# 建议选“非 CDN 单源站点”（避免 Cloudflare/Akamai 等多节点，握手更稳定）；
# 候选: www.microsoft.com:443 / www.nvidia.com:443 / www.tesla.com:443 / addons.mozilla.org:443
# 选定后用 `openssl s_client -connect <host>:443 -tls1_3` 复核确为 TLS1.3。
REALITY_DEST=www.microsoft.com:443

# ---- Hysteria2 (自签架构) ----
# Hy2 独立 SNI：与自签证书 CN、masquerade 保持一致（默认 www.bing.com）。
HY2_SNI=www.bing.com
# Hy2 salamander 混淆密码：留空则不启用混淆。
# 建议生成强随机值，例如: openssl rand -base64 24
OBFS_PASSWORD=

# 数据根目录（可选，默认由 scripts/lib/paths.sh 定义为 /opt/proxy/data）
# DATA_ROOT=/opt/proxy/data
